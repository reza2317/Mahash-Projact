rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Primitives
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isAnon() { return request.auth != null; }

    function isValidStoreChunk(data) {
      return data.keys().hasAll(['data', 'updatedAt']) &&
             data.keys().size() == 2 &&
             data.data is string && data.data.size() <= 1048576 &&
             data.updatedAt is string;
    }

    match /store/{chunkId} {
      // Allow get for everyone since this is public app data
      allow get: if isValidId(chunkId);
      // No list queries allowed to prevent scraping
      allow list: if false;
      
      allow create: if isAnon() && isValidId(chunkId) && isValidStoreChunk(incoming());
      allow update: if isAnon() && isValidId(chunkId) && isValidStoreChunk(incoming()) && 
                    (incoming().diff(existing()).affectedKeys().hasOnly(['data', 'updatedAt']));
      allow delete: if false;
    }
  }
}
