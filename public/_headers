# ==============================================================================
# Cloudflare Pages / Netlify Headers Configuration
# Ensures optimal caching, security, MIME types, and Single Page App (SPA) routing
# ==============================================================================

# Global security & CORS rules
/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  X-XSS-Protection: 1; mode=block
  Referrer-Policy: strict-origin-when-cross-origin
  Access-Control-Allow-Origin: *
  Access-Control-Allow-Methods: GET, POST, PUT, DELETE, OPTIONS
  Access-Control-Allow-Headers: Content-Type, Authorization, X-Requested-With

# Main HTML entry point - always revalidate to guarantee users get the latest app release
/index.html
  Cache-Control: public, max-age=0, must-revalidate
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff

# SPA Service Worker & Web App Manifest - no cache for immediate updates
/sw.js
  Cache-Control: public, max-age=0, must-revalidate

/manifest.webmanifest
  Cache-Control: public, max-age=0, must-revalidate
  Content-Type: application/manifest+json; charset=utf-8

/manifest.json
  Cache-Control: public, max-age=0, must-revalidate
  Content-Type: application/manifest+json; charset=utf-8

# Static build assets (Vite hashed bundles in /assets/) - 1 year immutable cache
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Static media uploads (images, logos, videos in /uploads/) - cached with stale-while-revalidate
/uploads/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
  Access-Control-Allow-Origin: *

# JSON data stores & sitemaps - always fresh
/*.json
  Cache-Control: public, max-age=0, must-revalidate

/sitemap.xml
  Cache-Control: public, max-age=3600, must-revalidate
  Content-Type: application/xml; charset=utf-8

/robots.txt
  Cache-Control: public, max-age=86400, must-revalidate
  Content-Type: text/plain; charset=utf-8
