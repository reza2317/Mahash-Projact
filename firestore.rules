rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Primitives
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }

    function isValidStoreChunk(data) {
      return data.data is string && data.data.size() <= 1048576;
    }

    function isValidTeamLogo(data) {
      return data.logoData is string && data.logoData.size() <= 1048576;
    }

    function isValidConsultantPhoto(data) {
      return data.photoData is string && data.photoData.size() <= 1048576;
    }

    function isValidPreference(data) {
      return data.theme is string && data.theme.size() <= 32;
    }

    function isValidAsset(data) {
      return data.data is string && data.data.size() <= 1048576;
    }

    match /assets/{assetId} {
      allow get: if isValidId(assetId);
      allow list: if false;
      allow create: if isValidId(assetId) && isValidAsset(incoming());
      allow update: if isValidId(assetId) && isValidAsset(incoming());
      allow delete: if isValidId(assetId);
    }

    match /store/{chunkId} {
      // Allow get for public state synchronization
      allow get: if isValidId(chunkId);
      // No list queries to prevent scraping
      allow list: if false;
      
      allow create: if isValidId(chunkId) && isValidStoreChunk(incoming());
      allow update: if isValidId(chunkId) && isValidStoreChunk(incoming());
      allow delete: if isValidId(chunkId);
    }

    match /team_logos/{teamId} {
      allow get: if isValidId(teamId);
      allow list: if false;
      allow create: if isValidId(teamId) && isValidTeamLogo(incoming());
      allow update: if isValidId(teamId) && isValidTeamLogo(incoming());
      allow delete: if isValidId(teamId);
    }

    match /consultant_photos/{consultantId} {
      allow get: if isValidId(consultantId);
      allow list: if false;
      allow create: if isValidId(consultantId) && isValidConsultantPhoto(incoming());
      allow update: if isValidId(consultantId) && isValidConsultantPhoto(incoming());
      allow delete: if isValidId(consultantId);
    }

    match /preferences/{prefId} {
      allow get: if isValidId(prefId);
      allow list: if false;
      allow create: if isValidId(prefId) && isValidPreference(incoming());
      allow update: if isValidId(prefId) && isValidPreference(incoming());
      allow delete: if isValidId(prefId);
    }
  }
}


